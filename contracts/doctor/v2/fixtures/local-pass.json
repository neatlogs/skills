{
  "format_version": "neatlogs.doctor/v2",
  "mode": "local",
  "status": "pass",
  "first_failure": null,
  "runtime": {
    "language": "typescript",
    "sdk_version": "1.1.19",
    "schema_version": "2",
    "transport": "otlp_http_protobuf"
  },
  "capture": {
    "trace_id": "11111111111111111111111111111111",
    "root_span_id": "1111111111111111",
    "span_count": 4,
    "semantic_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
  },
  "sampling": {
    "effective_sampler": "parentbased_traceidratio",
    "root_sample_rate": 1,
    "sampled": true
  },
  "ownership": {
    "provider": "private",
    "instrumentor_count": 0
  },
  "queue": {
    "mode": "diagnostic_capture",
    "pending_spans": 0,
    "dropped_spans": 0,
    "capacity": 2048
  },
  "retry": {
    "attempts": 0,
    "window_ms": 0,
    "exhausted": false
  },
  "flush": {
    "outcome": "success",
    "timeout_ms": 5000,
    "duration_ms": 12
  },
  "checks": [
    {
      "name": "local_envelope",
      "status": "pass",
      "reason_code": "LOCAL_ENVELOPE_VALID",
      "message": "The final normalized local envelope is valid",
      "remediation_code": "NONE"
    },
    {
      "name": "controlled_fixture_spans",
      "status": "pass",
      "reason_code": "CONTROLLED_SPANS_VALID",
      "message": "Doctor captured exactly the four expected semantic spans",
      "remediation_code": "NONE"
    },
    {
      "name": "controlled_fixture_hierarchy",
      "status": "pass",
      "reason_code": "CONTROLLED_HIERARCHY_VALID",
      "message": "Doctor captured the exact root-agent-LLM and root-tool edges",
      "remediation_code": "NONE"
    },
    {
      "name": "controlled_fixture_io",
      "status": "pass",
      "reason_code": "CONTROLLED_IO_VALID",
      "message": "Doctor captured the deterministic non-null input and output values",
      "remediation_code": "NONE"
    },
    {
      "name": "controlled_fixture_metadata",
      "status": "pass",
      "reason_code": "CONTROLLED_METADATA_VALID",
      "message": "Doctor captured all versioned metadata on every semantic span",
      "remediation_code": "NONE"
    },
    {
      "name": "controlled_fixture_tokens",
      "status": "pass",
      "reason_code": "CONTROLLED_TOKENS_VALID",
      "message": "Doctor captured the exact numeric token values",
      "remediation_code": "NONE"
    },
    {
      "name": "controlled_fixture_bounds",
      "status": "pass",
      "reason_code": "CONTROLLED_BOUNDS_VALID",
      "message": "Doctor stayed inside the bounded capture budget",
      "remediation_code": "NONE"
    }
  ]
}
