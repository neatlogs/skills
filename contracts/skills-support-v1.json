  "safe_fix_allowlist": {
    "requires_doctor_format": "neatlogs.doctor/v2",
    "entries": [
      {
        "reason_code": "SDK_VERSION_UNSUPPORTED",
        "action": "approved-package-upgrade",
        "source_edit": false,
        "requires_user_approval": true
      },
      {
        "reason_code": "INSTRUMENTOR_NOT_ACTIVE",
        "action": "supported-integration-edit",
        "source_edit": true,
        "requires_user_approval": true
      },
      {
        "reason_code": "ATTRIBUTE_CONFLICT",
        "action": "doctor-specified-conflict-edit",
        "source_edit": true,
        "requires_user_approval": true
      }
    ]
